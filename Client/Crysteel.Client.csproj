<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Crysteel.Client</AssemblyName>
    <RootNamespace>Crysteel</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GamePath>/game</GamePath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputPath>../Crysteel Client Build/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Api/CustomIngots.API.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(GamePath)/MelonLoader/net35/MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)/MelonLoader/net35/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Root.Township"><HintPath>$(GamePath)/A Township Tale_Data/Managed/Root.Township.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Alta.Values"><HintPath>$(GamePath)/A Township Tale_Data/Managed/Alta.Values.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)/A Township Tale_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Core.cs" />
    <Compile Include="../Source/CrystalMaterialDefaults.cs" Link="Shared/CrystalMaterialDefaults.cs" />
    <Compile Include="CrystalClientAppearancePatch.cs" />
    <Compile Include="IngotClientAppearance.cs" />
    <Compile Include="../Source/CrystalMaterialRegistration.cs" Link="Shared/CrystalMaterialRegistration.cs" />
    <Compile Include="../Source/CrystalAppearancePolicy.cs" Link="Shared/CrystalAppearancePolicy.cs" />
    <Compile Include="../Source/IngotRegistration.cs" Link="Shared/IngotRegistration.cs" />
    <Compile Include="../Source/IngotSpawnActivation.cs" Link="Shared/IngotSpawnActivation.cs" />
    <Compile Include="../Source/IngotForgeUnlock.cs" Link="Shared/IngotForgeUnlock.cs" />
  </ItemGroup>
</Project>
